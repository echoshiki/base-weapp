		"/shop/cart/add": {
			"post": {
				"tags": ["电商-购物车"],
				"summary": "加入购物车",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["goodsId", "skuId", "quantity"],
								"properties": {
									"goodsId": { "type": "string", "example": "GOODS_10001" },
									"skuId": { "type": "string", "example": "SKU_10001_1" },
									"quantity": { "type": "integer", "example": 1 }
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "加入成功",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["code", "msg", "data"],
									"properties": {
										"code": { "type": "integer", "enum": [200], "x-apifox-mock": "200", "example": 200 },
										"msg": { "type": "string", "x-apifox-mock": "已加入购物车", "example": "已加入购物车" },
										"data": {
											"type": "object",
											"required": ["id"],
											"properties": {
												"id": { "type": "string", "x-apifox-mock": "CART_@natural(1000, 9999)", "example": "CART_1003" }
											}
										}
									}
								},
								"example": { "code": 200, "msg": "已加入购物车", "data": { "id": "CART_1003" } }
							}
						}
					}
				}
			}
		},
