{
	"openapi": "3.0.3",
	"info": {
		"title": "Shop 模块接口（热插拔分包）",
		"version": "1.0.0",
		"description": "src/packages/shop 独立电商模块的 OpenAPI 3.0 文档。金额字段统一以「分」为单位，已为所有字段配置 x-apifox-mock 规则，导入 Apifox 开启云端 Mock 即可直接联调。"
	},
	"tags": [
		{ "name": "电商-商品", "description": "商品分类、分页列表与多规格 SKU 详情" },
		{ "name": "电商-购物车", "description": "购物车列表、加购、数量/勾选更新、全选与批量删除" }
	],
	"components": {
		"schemas": {
			"GoodsCategory": {
				"type": "object",
				"required": ["id", "name"],
				"properties": {
					"id": { "type": "string", "x-apifox-mock": "CAT_@natural(1, 20)", "example": "CAT_01" },
					"name": {
						"type": "string",
						"x-apifox-mock": "@pick(['精选数码', '居家生活', '个护美妆', '文创礼品', '户外出行'])",
						"example": "精选数码"
					}
				}
			},
			"GoodsItem": {
				"type": "object",
				"required": ["id", "title", "cover", "price", "sales"],
				"properties": {
					"id": { "type": "string", "x-apifox-mock": "GOODS_@natural(10000, 99999)", "example": "GOODS_10001" },
					"title": {
						"type": "string",
						"x-apifox-mock": "@pick(['极简无线降噪蓝牙耳机 Pro', '桌面磁吸无线快充支架', '日式手工粗陶手冲咖啡壶', '轻量化折叠机械键盘 75%', '便携保温随行咖啡杯 480ml', '高支长绒棉四季四件套'])",
						"example": "极简无线降噪蓝牙耳机 Pro"
					},
					"subtitle": {
						"type": "string",
						"x-apifox-mock": "@csentence(10, 20)",
						"example": "主动降噪 45dB · 36 小时超长续航 · 轻盈无感佩戴"
					},
					"cover": {
						"type": "string",
						"x-apifox-mock": "@pick(['https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80', 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80', 'https://images.unsplash.com/photo-1572635196237-14b3f281503f?w=600&auto=format&fit=crop&q=80', 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600&auto=format&fit=crop&q=80'])",
						"example": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80"
					},
					"price": { "type": "integer", "x-apifox-mock": "@integer(4900, 59900)", "example": 29900 },
					"originalPrice": { "type": "integer", "x-apifox-mock": "@integer(69000, 89900)", "example": 39900 },
					"sales": { "type": "integer", "x-apifox-mock": "@integer(80, 3200)", "example": 1280 },
					"categoryId": { "type": "string", "x-apifox-mock": "CAT_01", "example": "CAT_01" },
					"tags": {
						"type": "array",
						"maxItems": 2,
						"items": { "type": "string", "x-apifox-mock": "@pick(['官方自营', '顺丰包邮', '热销爆款', '新品上市'])" },
						"example": ["官方自营", "顺丰包邮"]
					}
				}
			},
			"GoodsSku": {
				"type": "object",
				"required": ["id", "specs", "price", "stock"],
				"properties": {
					"id": { "type": "string", "example": "SKU_10001_1" },
					"specs": {
						"type": "object",
						"additionalProperties": { "type": "string" },
						"example": { "颜色": "云白", "版本": "标准版" }
					},
					"price": { "type": "integer", "example": 29900 },
					"originalPrice": { "type": "integer", "example": 39900 },
					"stock": { "type": "integer", "example": 42 },
					"image": {
						"type": "string",
						"example": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80"
					}
				}
			},
			"CartItem": {
				"type": "object",
				"required": ["id", "goodsId", "skuId", "title", "image", "price", "quantity", "stock", "selected"],
				"properties": {
					"id": { "type": "string", "x-apifox-mock": "CART_@natural(1000, 9999)", "example": "CART_1001" },
					"goodsId": { "type": "string", "x-apifox-mock": "GOODS_10001", "example": "GOODS_10001" },
					"skuId": { "type": "string", "x-apifox-mock": "SKU_10001_1", "example": "SKU_10001_1" },
					"title": {
						"type": "string",
						"x-apifox-mock": "@pick(['极简无线降噪蓝牙耳机 Pro', '极简石英腕表 蓝宝石镜面', '日式手工粗陶手冲咖啡壶'])",
						"example": "极简无线降噪蓝牙耳机 Pro"
					},
					"image": {
						"type": "string",
						"x-apifox-mock": "@pick(['https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80', 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80'])",
						"example": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80"
					},
					"specText": {
						"type": "string",
						"x-apifox-mock": "@pick(['云白 / 标准版', '炭黑 / 旗舰降噪版', '经典银 / 40mm'])",
						"example": "云白 / 标准版"
					},
					"price": { "type": "integer", "x-apifox-mock": "@integer(9900, 45900)", "example": 29900 },
					"originalPrice": { "type": "integer", "x-apifox-mock": "@integer(49900, 59900)", "example": 39900 },
					"quantity": { "type": "integer", "x-apifox-mock": "@integer(1, 3)", "example": 1 },
					"stock": { "type": "integer", "x-apifox-mock": "@integer(10, 50)", "example": 28 },
					"selected": { "type": "boolean", "x-apifox-mock": "true", "example": true },
					"invalid": { "type": "boolean", "x-apifox-mock": "false", "example": false }
				}
			}
		}
	},
	"paths": {
		"/shop/categories": {
			"get": {
				"tags": ["电商-商品"],
				"summary": "获取商品分类列表",
				"responses": {
					"200": {
						"description": "获取成功",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["code", "msg", "data"],
									"properties": {
										"code": { "type": "integer", "enum": [200], "x-apifox-mock": "200", "example": 200 },
										"msg": { "type": "string", "x-apifox-mock": "success", "example": "success" },
										"data": {
											"type": "array",
											"minItems": 4,
											"maxItems": 5,
											"items": { "$ref": "#/components/schemas/GoodsCategory" }
										}
									}
								},
								"example": {
									"code": 200,
									"msg": "success",
									"data": [
										{ "id": "CAT_01", "name": "精选数码" },
										{ "id": "CAT_02", "name": "居家生活" },
										{ "id": "CAT_03", "name": "文创礼品" },
										{ "id": "CAT_04", "name": "户外出行" }
									]
								}
							}
						}
					}
				}
			}
		},
		"/shop/goods/list": {
			"get": {
				"tags": ["电商-商品"],
				"summary": "获取商品分页列表",
				"parameters": [
					{ "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
					{ "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 10 } },
					{ "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "搜索关键词" },
					{ "name": "categoryId", "in": "query", "schema": { "type": "string" }, "description": "分类 ID" },
					{
						"name": "sort",
						"in": "query",
						"schema": { "type": "string", "enum": ["default", "sales", "price_asc", "price_desc"] },
						"description": "排序方式"
					}
				],
				"responses": {
					"200": {
						"description": "获取成功",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["code", "msg", "data"],
									"properties": {
										"code": { "type": "integer", "enum": [200], "x-apifox-mock": "200", "example": 200 },
										"msg": { "type": "string", "x-apifox-mock": "success", "example": "success" },
										"data": {
											"type": "object",
											"required": ["list", "total", "page", "pageSize", "hasMore"],
											"properties": {
												"list": {
													"type": "array",
													"minItems": 6,
													"maxItems": 6,
													"items": { "$ref": "#/components/schemas/GoodsItem" }
												},
												"total": { "type": "integer", "x-apifox-mock": "6", "example": 6 },
												"page": { "type": "integer", "x-apifox-mock": "1", "example": 1 },
												"pageSize": { "type": "integer", "x-apifox-mock": "10", "example": 10 },
												"hasMore": { "type": "boolean", "x-apifox-mock": "false", "example": false }
											}
										}
									}
								},
								"example": {
									"code": 200,
									"msg": "success",
									"data": {
										"list": [
											{
												"id": "GOODS_10001",
												"title": "极简无线降噪蓝牙耳机 Pro",
												"subtitle": "主动降噪 45dB · 36 小时超长续航",
												"cover": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80",
												"price": 29900,
												"originalPrice": 39900,
												"sales": 1280,
												"categoryId": "CAT_01",
												"tags": ["官方自营", "顺丰包邮"]
											},
											{
												"id": "GOODS_10002",
												"title": "极简石英腕表 蓝宝石镜面",
												"subtitle": "超薄表盘 · 50 米生活防水",
												"cover": "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80",
												"price": 45900,
												"originalPrice": 59900,
												"sales": 864,
												"categoryId": "CAT_03",
												"tags": ["热销爆款"]
											}
										],
										"total": 2,
										"page": 1,
										"pageSize": 10,
										"hasMore": false
									}
								}
							}
						}
					}
				}
			}
		},
